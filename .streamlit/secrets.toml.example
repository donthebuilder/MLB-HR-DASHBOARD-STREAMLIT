# Copy this to .streamlit/secrets.toml locally, or paste the same keys into
# Streamlit Cloud → App settings → Secrets. NEVER commit the real file —
# .streamlit/secrets.toml is already in .gitignore.
#
# This is the Streamlit-side counterpart to the GitHub Actions secrets
# documented in docs/SOCIAL.md — the two are separate secret stores even
# when a key shares the same name, because they're two different runtimes.

# Already existed before the social pipeline — read access to the data
# branch, and (new) write access, since pages/1_Social_Queue.py commits
# Approve/Reject/Edit actions straight to public/data/current/social/*.json
# via the GitHub Contents API. Needs `contents: write` on this one repo —
# a fine-grained personal access token scoped to just this repo is the
# least-privilege option.
GITHUB_TOKEN = "ghp_..."

# Optional. Only needed if you want the queue page's "Publish Now" button to
# work directly from Streamlit Cloud, in addition to (or instead of)
# approving a post and letting a future workflow publish it. See
# docs/SOCIAL.md for how to obtain each of these — same values as the
# GitHub Actions secrets of the same name.
# X_API_KEY = "..."
# X_API_SECRET = "..."
# X_ACCESS_TOKEN = "..."
# X_ACCESS_TOKEN_SECRET = "..."
# META_ACCESS_TOKEN = "..."
# INSTAGRAM_ACCOUNT_ID = "..."
